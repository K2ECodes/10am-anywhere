# Copy to .env.local and fill in once the accounts exist. Every integration is
# optional: with nothing set, the site renders from the seed and wishlist falls
# back to localStorage. Add a block to switch that integration on.

# --- Sanity (content) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
# Deployed Studio URL, so /studio on the live site opens the editors' CMS:
NEXT_PUBLIC_SANITY_STUDIO_URL=

# --- Supabase (auth, wishlist, clicks, newsletter) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (transactional email) ---
RESEND_API_KEY=
NEWSLETTER_FROM="10am <info@10amanywhere.com>"
